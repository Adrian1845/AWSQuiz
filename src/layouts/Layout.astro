---
import "../styles/global.css";

interface Props { title: string; }
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A focused AWS Certified Solutions Architect Associate study quiz." />
    <meta name="theme-color" content="#17233a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>
